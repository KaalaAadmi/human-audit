{
  "expo": {
    "name": "HumanAudit",
    "slug": "human-audit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121316",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kaalaaadmi.humanaudit",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "HumanAudit uses Apple Health data to track HRV, sleep, readiness, and workouts.",
        "NSHealthUpdateUsageDescription": "HumanAudit writes hydration logs to your health record.",
        "NSCameraUsageDescription": "HumanAudit uses your camera to scan food barcodes and analyze meal photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#121316"
      },
      "package": "com.humanaudit.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
  "expo-router",
  "expo-status-bar",
  "expo-secure-store",
  "expo-camera",
  "@react-native-community/datetimepicker",
  "react-native-health-connect",
  "@kingstinct/react-native-healthkit",
  [
    "expo-splash-screen",
    {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121316",
      "imageWidth": 200
    }
  ]
],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36a34e0d-dc9b-468b-bc6a-305f8b2c0581"
      }
    }
  }
}
