# Supabase Managed PostgreSQL Connection String
# Find in Supabase Dashboard > Project Settings > Database > Connection String (URI, port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
