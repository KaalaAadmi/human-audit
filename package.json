{
    "name": "human-audit",
    "private": "true",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "mobile": "npm run start --workspace=apps/mobile",
        "web": "npm run dev --workspace=apps/web",
        "build": "turbo run build",
        "lint": "turbo run lint"
    },
    "devDependencies": {
        "turbo": "2.11.8",
        "typescript": "7.0.2"
    },
    "overrides": {
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native-reanimated": "4.5.1",
        "react-native-worklets": "0.10.1"
    }
}
