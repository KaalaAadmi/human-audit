{
  "expo": {
    "name": "HumanAudit",
    "slug": "human-audit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121316",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121316"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.humanaudit.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "HumanAudit needs access to your sleep, workout, and heart rate data to calculate your Readiness and Heart Rate Zones.",
        "NSHealthUpdateUsageDescription": "HumanAudit writes hydration logs to your health record.",
        "NSCameraUsageDescription": "HumanAudit uses your camera to scan food barcodes and analyze meal photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121316"
      },
      "package": "com.humanaudit.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-camera",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
